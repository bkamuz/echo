<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="echo.App.Views.DictationCursorOverlayWindow"
        Title="Echo"
        Width="24"
        Height="24"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual">

  <StackPanel Orientation="Horizontal"
              Spacing="4"
              IsHitTestVisible="False">
    <Image x:Name="IconImage"
           Width="24"
           Height="24"
           Stretch="Uniform"
           IsHitTestVisible="False"/>

    <Border x:Name="MeterPanel"
            Classes="dictation-eq-meter"
            Width="72"
            Height="24"
            IsVisible="False"
            IsHitTestVisible="False"
            Padding="2">
      <Image x:Name="SpectrogramImage"
             Width="68"
             Height="20"
             Stretch="Fill"
             IsHitTestVisible="False"/>
    </Border>
  </StackPanel>
</Window>
