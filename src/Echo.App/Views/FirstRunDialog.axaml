<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:echo.App.Views"
        x:Class="echo.App.Views.FirstRunDialog"
        x:DataType="views:FirstRunViewModel"
        Title="Добро пожаловать в Echo"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Border Classes="tile" Margin="16">
    <StackPanel Spacing="14" Margin="16">
      <TextBlock Classes="page-title" Text="Начните диктовку"/>
      <TextBlock Classes="page-subtitle"
                 TextWrapping="Wrap"
                 Text="Скачайте модель распознавания один раз — дальше Echo работает полностью офлайн."/>

      <StackPanel Spacing="4">
        <TextBlock FontWeight="SemiBold" Text="{Binding ModelTitle}"/>
        <TextBlock Classes="page-subtitle" Text="{Binding HotkeyHint}"/>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 Classes="page-subtitle"
                 TextWrapping="Wrap"
                 Text=""/>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="LaterButton" Content="Позже" Click="OnLaterClick"/>
        <Button x:Name="DownloadButton"
                Classes="accent"
                Content="Скачать модель"
                Click="OnDownloadClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
