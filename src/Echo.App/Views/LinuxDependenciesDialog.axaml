<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:linux="using:echo.Platform.Linux"
        xmlns:views="using:echo.App.Views"
        x:Class="echo.App.Views.LinuxDependenciesDialog"
        Title="{DynamicResource Loc.Linux.Dialog.Title}"
        Width="560"
        SizeToContent="Height"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Focusable="True">

  <Border Classes="tile" Margin="16">
    <StackPanel Spacing="12" Margin="16">
      <TextBlock x:Name="StepTitle" Classes="page-title" Text="Шаг 1 из 2 — Системные пакеты"/>
      <TextBlock x:Name="StepSubtitle"
                 Classes="page-subtitle"
                 TextWrapping="Wrap"
                 Text="{DynamicResource Loc.Linux.Dialog.Packages.Subtitle}"/>

      <StackPanel x:Name="PackagesPanel" Spacing="8">
        <ItemsControl x:Name="DependenciesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:LinuxDependencyView">
              <StackPanel Margin="0,0,0,8" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                <TextBlock Classes="page-subtitle" TextWrapping="Wrap" Text="{Binding Description}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel x:Name="AccessibilityPanel" Spacing="8" IsVisible="False">
        <TextBlock x:Name="AccessibilityInstructions"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="LimitationsText"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
        <Button x:Name="OpenAccessibilityButton"
                Content="{DynamicResource Loc.Linux.Dialog.OpenA11y}"
                HorizontalAlignment="Left"
                Click="OnOpenAccessibilityClick"/>
      </StackPanel>

      <StackPanel x:Name="TestPanel" Spacing="8" IsVisible="False">
        <TextBlock Classes="page-subtitle"
                   TextWrapping="Wrap"
                   Text="{DynamicResource Loc.Linux.Dialog.Test.Hint}"/>
        <TextBox x:Name="TestInput"
                 PlaceholderText="{DynamicResource Loc.Linux.Dialog.Test.Placeholder}"
                 MinHeight="36"/>
        <Button x:Name="TestButton"
                Content="{DynamicResource Loc.Linux.Dialog.Test.Button}"
                HorizontalAlignment="Left"
                Click="OnTestClick"/>
        <TextBlock x:Name="TestResultText"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"
                   IsVisible="False"/>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 Classes="page-subtitle"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <CheckBox x:Name="DontAskAgainCheckBox"
                Content="{DynamicResource Loc.Linux.Dialog.DontAsk}"/>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button x:Name="BackButton"
                Content="{DynamicResource Loc.Linux.Dialog.Back}"
                IsVisible="False"
                Click="OnBackClick"/>
        <Button x:Name="SkipButton"
                Content="{DynamicResource Loc.Linux.Dialog.Skip}"
                Click="OnSkipClick"/>
        <Button x:Name="InputGroupButton"
                Content="{DynamicResource Loc.Linux.Dialog.InputGroup}"
                IsVisible="False"
                Click="OnInputGroupClick"/>
        <Button x:Name="InstallButton"
                Classes="primary"
                Content="{DynamicResource Loc.Linux.Dialog.Install}"
                Click="OnInstallClick"/>
        <Button x:Name="NextButton"
                Classes="primary"
                Content="{DynamicResource Loc.Linux.Dialog.Next}"
                IsVisible="False"
                Click="OnNextClick"/>
        <Button x:Name="FinishButton"
                Classes="primary"
                Content="{DynamicResource Loc.Linux.Dialog.Finish}"
                IsVisible="False"
                Click="OnFinishClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
