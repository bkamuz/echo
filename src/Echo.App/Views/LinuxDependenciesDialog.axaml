<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:linux="using:echo.Platform.Linux"
        x:Class="echo.App.Views.LinuxDependenciesDialog"
        Title="Настройка Linux"
        Width="560"
        SizeToContent="Height"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Focusable="True">

  <Border Classes="tile" Margin="16">
    <StackPanel Spacing="12" Margin="16">
      <TextBlock x:Name="StepTitle" Classes="page-title" Text="Шаг 1 из 2 — Системные пакеты"/>
      <TextBlock x:Name="StepSubtitle"
                 Classes="page-subtitle"
                 TextWrapping="Wrap"
                 Text="Echo подберёт способ вставки автоматически."/>

      <StackPanel x:Name="PackagesPanel" Spacing="8">
        <ItemsControl x:Name="DependenciesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="linux:LinuxDependency">
              <StackPanel Margin="0,0,0,8" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                <TextBlock Classes="page-subtitle" TextWrapping="Wrap" Text="{Binding Description}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel x:Name="AccessibilityPanel" Spacing="8" IsVisible="False">
        <TextBlock x:Name="AccessibilityInstructions"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="LimitationsText"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"/>
        <Button x:Name="OpenAccessibilityButton"
                Content="Открыть настройки спец. возможностей"
                HorizontalAlignment="Left"
                Click="OnOpenAccessibilityClick"/>
      </StackPanel>

      <StackPanel x:Name="TestPanel" Spacing="8" IsVisible="False">
        <TextBlock Classes="page-subtitle"
                   TextWrapping="Wrap"
                   Text="Поставьте курсор в поле ниже и нажмите «Проверить вставку»."/>
        <TextBox x:Name="TestInput"
                 PlaceholderText="Курсор сюда…"
                 MinHeight="36"/>
        <Button x:Name="TestButton"
                Content="Проверить вставку"
                HorizontalAlignment="Left"
                Click="OnTestClick"/>
        <TextBlock x:Name="TestResultText"
                   Classes="page-subtitle"
                   TextWrapping="Wrap"
                   IsVisible="False"/>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 Classes="page-subtitle"
                 TextWrapping="Wrap"
                 IsVisible="False"/>

      <CheckBox x:Name="DontAskAgainCheckBox"
                Content="Больше не показывать этот мастер"/>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button x:Name="BackButton"
                Content="Назад"
                IsVisible="False"
                Click="OnBackClick"/>
        <Button x:Name="SkipButton"
                Content="Пропустить"
                Click="OnSkipClick"/>
        <Button x:Name="InputGroupButton"
                Content="Группа input"
                IsVisible="False"
                Click="OnInputGroupClick"/>
        <Button x:Name="InstallButton"
                Classes="primary"
                Content="Установить пакеты"
                Click="OnInstallClick"/>
        <Button x:Name="NextButton"
                Classes="primary"
                Content="Далее"
                IsVisible="False"
                Click="OnNextClick"/>
        <Button x:Name="FinishButton"
                Classes="primary"
                Content="Готово"
                IsVisible="False"
                Click="OnFinishClick"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
