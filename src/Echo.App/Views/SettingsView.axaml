<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:echo.App.ViewModels"
             x:Class="echo.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             Focusable="True">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                VerticalAlignment="Stretch"
                IsEnabled="{Binding IsSettingsEnabled}">
      <StackPanel Spacing="12">

        <Border Classes="tile">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="tile-header">
              <TextBlock Classes="section-title" Text="УПРАВЛЕНИЕ"/>
            </Border>
            <StackPanel Classes="tile-body" Spacing="10">
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Classes="settings-field">
                  <TextBlock Classes="field-label" Text="Хоткей"/>
                  <Button Classes="hotkey-field"
                          Classes.capturing="{Binding IsCapturingHotkey}"
                          Content="{Binding HotkeyDisplay}"
                          Command="{Binding ToggleHotkeyCaptureCommand}"
                          HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="settings-field">
                  <TextBlock Classes="field-label" Text="Метод ввода"/>
                  <ComboBox ItemsSource="{Binding InputMethodOptions}"
                            SelectedItem="{Binding SelectedInputMethod}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:InputMethodOption">
                        <TextBlock Text="{Binding DisplayName}"
                                   ToolTip.Tip="{Binding Tooltip}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Classes="settings-field"
                            MinWidth="140"
                            IsVisible="{Binding IsTypeInput}">
                  <TextBlock Classes="field-label" Text="Скорость печати"
                             ToolTip.Tip="{Binding TypeSpeedTooltip}"/>
                  <ComboBox ItemsSource="{Binding TypeSpeedOptions}"
                            SelectedItem="{Binding SelectedTypeSpeed}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="Пробел в конце фразы"
                          IsChecked="{Binding AddTrailingSpace}"/>
                <CheckBox Content="Показывать текст после диктовки"
                          IsChecked="{Binding ShowDictationToast}"
                          ToolTip.Tip="Вспышка с распознанным текстом. Нажмите на неё, чтобы скопировать."/>
                <CheckBox Content="Запускать при старте системы"
                          IsChecked="{Binding StartWithSystem}"
                          IsVisible="{Binding IsAutoStartSupported}"
                          ToolTip.Tip="Echo запустится в фоне при входе в систему"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Classes="tile">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="tile-header">
              <TextBlock Classes="section-title" Text="РАСПОЗНАВАНИЕ"/>
            </Border>
            <StackPanel Classes="tile-body" Spacing="10">
              <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Grid.Column="0"
                            Classes="settings-field"
                            IsVisible="{Binding IsDeviceVisible}">
                  <TextBlock Classes="field-label" Text="Устройство"/>
                  <ComboBox ItemsSource="{Binding ComputeDeviceOptions}"
                            SelectedItem="{Binding SelectedComputeDevice}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ComputeDeviceOption">
                        <TextBlock Text="{Binding DisplayName}"
                                   ToolTip.Tip="{Binding Tooltip}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="0"
                            Classes="settings-field"
                            IsVisible="{Binding IsWhisper}">
                  <TextBlock Classes="field-label" Text="Язык"/>
                  <ComboBox ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding Language}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Classes="settings-field">
                  <TextBlock Classes="field-label" Text="Движок"/>
                  <ComboBox ItemsSource="{Binding EngineOptions}"
                            SelectedItem="{Binding SelectedEngine}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Classes="settings-field"
                            IsVisible="{Binding IsGigaAm}">
                  <TextBlock Classes="field-label" Text="Модель"/>
                  <ComboBox ItemsSource="{Binding GigaAmSizes}"
                            SelectedItem="{Binding GigaAmModelSize}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Classes="settings-field"
                            IsVisible="{Binding IsWhisper}">
                  <TextBlock Classes="field-label" Text="Модель"/>
                  <ComboBox ItemsSource="{Binding WhisperSizes}"
                            SelectedItem="{Binding WhisperModelSize}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Classes="settings-field"
                            IsVisible="{Binding IsOmnilingual}">
                  <TextBlock Classes="field-label" Text="Модель"/>
                  <TextBlock Text="Omnilingual ASR 300M"
                             FontSize="13"
                             MinHeight="32"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Classes="settings-field" Width="32">
                  <TextBlock Classes="field-label" Text=" "/>
                  <Button Classes="icon-action"
                          IsEnabled="False"
                          IsVisible="{Binding IsModelDownloaded}"
                          ToolTip.Tip="{Binding ModelLoadedTooltip}"
                          Focusable="False">
                    <PathIcon Data="{StaticResource IconCheck}"
                              Width="16"
                              Height="16"
                              Foreground="{DynamicResource SuccessTextBrush}"/>
                  </Button>
                  <Button Classes="icon-action"
                          IsVisible="{Binding ShowModelDownloadButton}"
                          Command="{Binding DownloadModelCommand}"
                          ToolTip.Tip="{Binding ModelDownloadTooltip}"
                          IsEnabled="{Binding IsSettingsEnabled}">
                    <PathIcon Data="{StaticResource IconDownload}"
                              Width="16"
                              Height="16"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Classes="settings-field" Width="32">
                  <TextBlock Classes="field-label" Text=" "/>
                  <Button Classes="icon-action"
                          IsVisible="{Binding IsModelDownloaded}"
                          Command="{Binding DeleteModelCommand}"
                          ToolTip.Tip="{Binding ModelDeleteTooltip}"
                          IsEnabled="{Binding IsSettingsEnabled}">
                    <PathIcon Data="{StaticResource IconTrash}"
                              Width="16"
                              Height="16"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>

              <TextBlock Text="e2e — с пунктуацией и нормализацией, rnnt — только текст"
                         IsVisible="{Binding IsGigaAm}"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Text="auto — автовыбор (рекомендуется для англ. слов). Whisper работает на CPU."
                         IsVisible="{Binding IsWhisper}"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Classes="tile">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="tile-header">
              <TextBlock Classes="section-title" Text="АУДИО"/>
            </Border>
            <StackPanel Classes="tile-body settings-field">
              <TextBlock Classes="field-label" Text="Микрофон"/>
              <ComboBox ItemsSource="{Binding InputDevices}"
                        SelectedItem="{Binding InputDevice}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </DockPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
</UserControl>
