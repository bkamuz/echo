<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:echo.App.ViewModels"
             x:Class="echo.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             VerticalAlignment="Stretch">

  <Border Classes="tile" ClipToBounds="True" VerticalAlignment="Stretch">
      <Grid>
        <StackPanel IsVisible="{Binding IsLoadingInitial}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="24">
          <TextBlock Text="{DynamicResource Loc.History.Loading}"
                     FontSize="14"
                     Foreground="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsEmpty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Margin="24">
          <PathIcon Data="{StaticResource IconHistory}"
                    Width="32" Height="32"
                    Foreground="{DynamicResource TextMutedBrush}"
                    HorizontalAlignment="Center"/>
          <TextBlock Text="{DynamicResource Loc.History.Empty}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center"/>
          <TextBlock Classes="page-subtitle"
                     Text="{DynamicResource Loc.History.EmptyHint}"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"/>
        </StackPanel>

        <Grid IsVisible="{Binding HasEntries}" RowDefinitions="*,Auto">
          <ListBox x:Name="HistoryList"
                   Grid.Row="0"
                   ItemsSource="{Binding Entries}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryItemView">
                <Border Classes="history-item">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Engine}"
                               Classes="mono"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource LinkBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               LineHeight="20"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Classes="ghost"
                            Command="{Binding $parent[UserControl].((vm:HistoryViewModel)DataContext).CopyTextCommand}"
                            CommandParameter="{Binding Text}"
                            ToolTip.Tip="{DynamicResource Loc.History.Copy}"
                            Width="32"
                            Height="32"
                            Padding="4"
                            VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconCopy}"
                                Width="16"
                                Height="16"/>
                    </Button>
                    <TextBlock Grid.Column="3"
                               Text="{Binding Timestamp}"
                               Classes="mono"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="1"
                     IsVisible="{Binding IsLoadingMore}"
                     Text="{DynamicResource Loc.History.LoadingMore}"
                     FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"
                     HorizontalAlignment="Center"
                     Margin="0,8,0,4"/>
        </Grid>
      </Grid>
  </Border>
</UserControl>
