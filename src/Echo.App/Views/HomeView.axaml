<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:echo.App.ViewModels"
             x:Class="echo.App.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             VerticalAlignment="Stretch">

  <StackPanel Spacing="16" VerticalAlignment="Top">
      <Border Classes="tile">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="tile-header">
            <TextBlock Classes="section-title" Text="ГОРЯЧАЯ КЛАВИША"/>
          </Border>
          <StackPanel Classes="tile-body" Spacing="8">
            <TextBlock Text="{Binding HotkeyHint}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource LinkBrush}"/>
            <TextBlock Classes="page-subtitle"
                       Text="Удерживайте комбинацию для записи. Отпустите — текст вставится в активное поле."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Classes="tile">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="tile-header">
            <TextBlock Classes="section-title" Text="ТЕКУЩАЯ МОДЕЛЬ"/>
          </Border>
          <StackPanel Classes="tile-body" Spacing="8">
            <TextBlock Text="{Binding ModelInfo}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource LinkBrush}"/>
            <TextBlock Classes="page-subtitle"
                       Text="Движок и модель можно изменить в настройках"/>
          </StackPanel>
        </DockPanel>
      </Border>
  </StackPanel>
</UserControl>
