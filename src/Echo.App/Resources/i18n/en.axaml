  <sys:String x:Key="Loc.FirstRun.Title">Welcome to Echo</sys:String>
  <sys:String x:Key="Loc.FirstRun.Heading">Start dictating</sys:String>
  <sys:String x:Key="Loc.FirstRun.Body">Download the recognition model once — then Echo works fully offline.</sys:String>
