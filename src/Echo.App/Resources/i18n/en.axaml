  <sys:String x:Key="Loc.Toast.CopyHint">Click to copy</sys:String>

  <sys:String x:Key="Loc.Linux.Dialog.Title">Linux setup</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.StepPackages.Title">Step {0} of {1} — System packages</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.StepA11y.Title">Step {0} of {1} — Accessibility</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.StepTest.Title">Step {0} of {1} — Paste test</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Packages.Subtitle">Echo will pick the paste method automatically.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Packages.Subtitle.Gnome">On GNOME Wayland Echo pastes via clipboard and ydotool.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.A11y.Subtitle">Automatic paste via AT-SPI needs accessibility access.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Subtitle">Make sure paste works in your environment.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Hint">Place the cursor in the field below and click “Test paste”.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Placeholder">Cursor here…</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Button">Test paste</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.OpenA11y">Open accessibility settings</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.DontAsk">Don't show this wizard again</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Back">Back</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Skip">Skip</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.InputGroup">input group</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Install">Install packages</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Next">Next</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Finish">Done</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.FlatpakHint">In Flatpak, dependencies ship with the Echo package or via the system package manager.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.ManualInstall">Auto-install is unavailable. Install packages manually via your distro's package manager.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.TestPhrase">Echo — paste test.</sys:String>

  <sys:String x:Key="Loc.Linux.Dep.arecord.Title">Microphone capture (arecord)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.arecord.Description">Required to record voice during dictation.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.python3-gi.Title">Python AT-SPI (python3-gi)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.python3-gi.Description">Required for automatic text insertion via accessibility APIs.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.atspi.Title">AT-SPI (gir1.2-atspi-2.0)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.atspi.Description">Required to insert text into other apps' input fields.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.wl-copy.Title">Wayland clipboard (wl-clipboard)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.wl-copy.Description">Required to copy recognized text to the clipboard.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.ydotool.Title">GNOME Wayland keyboard emulation (ydotool)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.ydotool.Description">Required for Ctrl+V auto-paste on GNOME Wayland (needs ydotoold and the input group).</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.gpaste-client.Title">Panel-flash-free clipboard (GPaste)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.gpaste-client.Description">Recommended on GNOME Wayland: auto-paste without a panel icon. Alternative: sudo apt install xclip. After GPaste, re-login and enable the extension.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.wtype.Title">Wayland keyboard emulation (wtype)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.wtype.Description">Required for auto-paste in Sway, Hyprland, and other wlroots compositors.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.xclip.Title">X11 clipboard (xclip)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.xclip.Description">Required to copy recognized text to the clipboard.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.xdotool.Title">X11 keyboard emulation (xdotool)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.xdotool.Description">Required for auto-paste in an X11 session.</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.sg.Title">input group without re-login (sg)</sys:String>
  <sys:String x:Key="Loc.Linux.Dep.sg.Description">Required for the global hotkey if you are already in the input group but have not re-logged in yet.</sys:String>

  <sys:String x:Key="Loc.Linux.Warn.NoSession">Could not detect a graphical session (Wayland or X11 required).</sys:String>
  <sys:String x:Key="Loc.Linux.Warn.Inject.Gnome">Install ydotool (with ydotoold) for auto-paste on GNOME Wayland.</sys:String>
  <sys:String x:Key="Loc.Linux.Warn.Inject.Wayland">Install wl-clipboard and python3-gi for text paste.</sys:String>
  <sys:String x:Key="Loc.Linux.Warn.Inject.X11">Install xclip and xdotool for text paste.</sys:String>
  <sys:String x:Key="Loc.Linux.Warn.MissingPackages">Dictation needs system components — Echo can install them at startup.</sys:String>
  <sys:String x:Key="Loc.Linux.Warn.MissingPackages.Suffix">Echo can install missing packages at startup.</sys:String>
  <sys:String x:Key="Loc.Linux.Hotkey.PendingReloginSg">Global hotkey unavailable: you are in the input group, but the session has not refreshed yet. Install util-linux-extra (sg command) via Echo's dependency dialog, or log out and back in.</sys:String>
  <sys:String x:Key="Loc.Linux.Hotkey.PendingRelogin">Global hotkey unavailable: you are in the input group, but the session has not refreshed yet. Log out and back in, then restart Echo.</sys:String>
  <sys:String x:Key="Loc.Linux.Hotkey.NotConfigured">Global hotkey unavailable: add your user to the input group (Settings → “input group” or: sudo usermod -aG input $USER), then re-login.</sys:String>
  <sys:String x:Key="Loc.Linux.A11y.Instructions.Generic">Open accessibility settings and allow Echo to control applications (AT-SPI).</sys:String>
  <sys:String x:Key="Loc.Linux.A11y.Instructions.Gnome">GNOME: Settings → Accessibility → Allow applications to control your desktop (or install ydotool).</sys:String>
  <sys:String x:Key="Loc.Linux.A11y.Instructions.GnomeWayland">GNOME Wayland: enable Settings → Accessibility → Assistive Technology Support so Echo can paste via AT-SPI without panel flash. If disabled, clipboard + Ctrl+V (ydotool) is used.</sys:String>
  <sys:String x:Key="Loc.Linux.A11y.Instructions.Kde">KDE: open System Settings → Accessibility and enable AT-SPI support.</sys:String>
  <sys:String x:Key="Loc.Linux.A11y.Limitations">Works well in browsers, office apps, and most input fields. In some games, ncurses terminals, and sandboxed apps only clipboard copy remains.</sys:String>
  <sys:String x:Key="Loc.Linux.Inject.NeedWlClipboard">Install wl-clipboard for text paste.</sys:String>
  <sys:String x:Key="Loc.Linux.Inject.NeedXclip">Install xclip or xsel for text paste.</sys:String>
  <sys:String x:Key="Loc.Linux.Inject.ClipboardOnly">Text copied — press Ctrl+V.</sys:String>
  <sys:String x:Key="Loc.Inject.Failed">Could not paste text — result saved to history</sys:String>
  <sys:String x:Key="Loc.Status.RecognitionError">Recognition error</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.AdminInstall">Administrator privileges requested. Confirm installation in the system dialog…</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.AdminInputGroup">Administrator privileges requested to add you to the input group…</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.OpenA11yManual">Open accessibility settings manually.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Testing">Testing…</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Success">Success — text was pasted automatically.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Partial">Partial — {0}</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Fail">Failed: {0}</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Test.Error">Error: {0}</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Packages.Subtitle.GnomeDetail">On GNOME Wayland Echo uses ydotool for auto-paste. Install ydotool, wl-clipboard, and arecord.</sys:String>
  <sys:String x:Key="Loc.Linux.Dialog.Packages.Subtitle.Detail">Echo will pick the paste method automatically (AT-SPI, xdotool, or wtype). Install any missing components.</sys:String>

</ResourceDictionary>
