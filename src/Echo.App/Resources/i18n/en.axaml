  <sys:String x:Key="Loc.Settings.Microphone">Microphone</sys:String>
  <sys:String x:Key="Loc.Settings.GigaAmHint">e2e — RNNT with punctuation; e2e-ctc — CTC with punctuation (faster); rnnt — plain text; multilingual — multilingual CTC (ru/kk/ky/uz…)</sys:String>
  <sys:String x:Key="Loc.Settings.WhisperHint">auto — auto-detect (recommended for English words). Whisper runs on CPU.</sys:String>
  <sys:String x:Key="Loc.Settings.ModelLoaded.Tooltip">{0} downloaded and ready for recognition</sys:String>
  <sys:String x:Key="Loc.Settings.ModelDownload.Tooltip">Download {0} to this device</sys:String>
  <sys:String x:Key="Loc.Settings.ModelDelete.Tooltip">Delete {0} files from this device</sys:String>

  <sys:String x:Key="Loc.Engine.GigaAm">GigaAM (Russian)</sys:String>
  <sys:String x:Key="Loc.Engine.Whisper">Whisper (multilingual)</sys:String>
  <sys:String x:Key="Loc.Engine.Omnilingual">Omnilingual (1600 languages)</sys:String>
  <sys:String x:Key="Loc.Device.Cpu">CPU</sys:String>
  <sys:String x:Key="Loc.Device.Cpu.Tooltip">Universal mode. Works on any PC.</sys:String>
  <sys:String x:Key="Loc.Device.DirectMl">GPU (DirectML)</sys:String>
  <sys:String x:Key="Loc.Device.DirectMl.Tooltip">Acceleration via DirectML on Windows (AMD Radeon, Intel, NVIDIA). First selection downloads ~30 MB.</sys:String>
  <sys:String x:Key="Loc.Input.Clipboard">Clipboard paste</sys:String>
  <sys:String x:Key="Loc.Input.Clipboard.Tooltip">Fast paste. Clipboard contents are restored after paste.</sys:String>
  <sys:String x:Key="Loc.Input.Type">Type</sys:String>
  <sys:String x:Key="Loc.Input.Type.Tooltip">Character-by-character input via keyboard emulation.</sys:String>
  <sys:String x:Key="Loc.Input.Auto">Auto</sys:String>
  <sys:String x:Key="Loc.Input.Linux.Auto.Gnome.Tooltip">On GNOME Wayland — paste via Echo clipboard and ydotool (Ctrl+V), without wl-copy. If the panel flashes — restart Echo.</sys:String>
  <sys:String x:Key="Loc.Input.Linux.Clipboard.Gnome.Tooltip">Instant paste of the full text via clipboard and Ctrl+V (ydotool).</sys:String>
  <sys:String x:Key="Loc.Input.Linux.Auto.Tooltip">Echo picks the best method: AT-SPI, ydotool, xdotool, or wtype. If auto-paste is unavailable — text is copied to the clipboard.</sys:String>
  <sys:String x:Key="Loc.Input.Linux.Clipboard.Tooltip">AT-SPI first; otherwise Ctrl+V emulation via ydotool, xdotool, or wtype.</sys:String>
  <sys:String x:Key="Loc.TypeSpeed.Fast">Fast</sys:String>
  <sys:String x:Key="Loc.TypeSpeed.Normal">Normal</sys:String>
  <sys:String x:Key="Loc.TypeSpeed.Smooth">Smooth</sys:String>
