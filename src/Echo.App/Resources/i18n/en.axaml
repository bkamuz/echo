  <sys:String x:Key="Loc.Settings.TypeSpeed">Typing speed</sys:String>
  <sys:String x:Key="Loc.Settings.TypeSpeed.Tooltip">Delay between characters in Type mode</sys:String>
  <sys:String x:Key="Loc.Settings.TrailingSpace">Trailing space after phrase</sys:String>
  <sys:String x:Key="Loc.Settings.PostRelease">Release tail</sys:String>
  <sys:String x:Key="Loc.Settings.PostRelease.Tooltip">Keep recording briefly after you release the hotkey so the last syllable is not cut off</sys:String>
  <sys:String x:Key="Loc.Settings.ShowToast">Show text when paste fails</sys:String>
  <sys:String x:Key="Loc.Settings.ShowToast.Tooltip">Flash with recognized text only if insertion failed. Click it to copy.</sys:String>
  <sys:String x:Key="Loc.Settings.StartWithSystem">Start with system</sys:String>
  <sys:String x:Key="Loc.Settings.StartWithSystem.Tooltip">Echo starts in the background at login</sys:String>
  <sys:String x:Key="Loc.Settings.UiLanguage">Interface language</sys:String>
