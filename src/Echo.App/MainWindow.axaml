<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:echo.App.ViewModels"
        xmlns:views="using:echo.App.Views"
        xmlns:conv="using:echo.App.Converters"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:input="using:Avalonia.Input"
        x:Class="echo.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Echo"
        Width="960" Height="640"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="56">

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{StaticResource ShellChromeGridLength}"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="2"
            Classes="shell-rail">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="shell-brand-cell">
          <Image Source="avares://echo.App/Resources/main.png"
                 Width="{StaticResource ShellBrandIconSize}"
                 Height="{StaticResource ShellBrandIconSize}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                x:Name="SidebarHost"
                Classes="sidebar">
          <StackPanel Spacing="0"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Stretch">
            <Button Classes="sidebar-nav-item"
                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Home}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static vm:AppPage.Home}"
                    ToolTip.Tip="Главная">
              <PathIcon Data="{StaticResource IconHome}"
                        Width="16"
                        Height="16"/>
            </Button>

            <Button Classes="sidebar-nav-item"
                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.Settings}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static vm:AppPage.Settings}"
                    ToolTip.Tip="Настройки">
              <PathIcon Data="{StaticResource IconSettings}"
                        Width="16"
                        Height="16"/>
            </Button>

            <Button Classes="sidebar-nav-item"
                    Classes.active="{Binding SelectedPage, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AppPage.History}}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="{x:Static vm:AppPage.History}"
                    ToolTip.Tip="История">
              <PathIcon Data="{StaticResource IconHistory}"
                        Width="16"
                        Height="16"/>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="0"
            x:Name="TitleBarHost"
            Classes="shell-header-main"
            Cursor="Arrow">
      <Grid ColumnDefinitions="*,Auto,144"
            x:Name="TitleBarGrid">
        <Border Grid.Column="0"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Cursor="Arrow"
                chrome:WindowDecorationProperties.ElementRole="{x:Static input:WindowDecorationsElementRole.TitleBar}">
          <StackPanel VerticalAlignment="Center"
                      Spacing="0"
                      Margin="12,0,0,0">
            <TextBlock Classes="page-title"
                       Text="{Binding PageTitle}"/>
            <TextBlock Classes="page-subtitle"
                       Text="{Binding PageSubtitle}"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1"
                    x:Name="UpdateButtonPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Panel.ZIndex="1"
                    IsVisible="{Binding Update.IsAvailable}">
          <Button Classes="icon-action"
                  Command="{Binding Update.ApplyCommand}"
                  IsEnabled="{Binding !Update.IsApplying}"
                  ToolTip.Tip="{Binding Update.Tooltip}">
            <PathIcon Data="{StaticResource IconDownload}"
                      Width="16"
                      Height="16"/>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    x:Name="ClientCaptionButtons"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    IsVisible="False">
          <Button Classes="shell-caption-button"
                  Content="&#x2212;"
                  ToolTip.Tip="Свернуть"
                  chrome:WindowDecorationProperties.ElementRole="{x:Static input:WindowDecorationsElementRole.MinimizeButton}"/>
          <Button Classes="shell-caption-button"
                  Content="&#x25A1;"
                  ToolTip.Tip="Развернуть"
                  chrome:WindowDecorationProperties.ElementRole="{x:Static input:WindowDecorationsElementRole.MaximizeButton}"/>
          <Button Classes="shell-caption-button shell-caption-button-close"
                  Content="&#x00D7;"
                  ToolTip.Tip="Закрыть"
                  chrome:WindowDecorationProperties.ElementRole="{x:Static input:WindowDecorationsElementRole.CloseButton}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="1"
            x:Name="ContentHost"
            Classes="content-host"
            ClipToBounds="True">
      <ContentControl Content="{Binding CurrentPage}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
          <DataTemplate DataType="vm:HistoryViewModel">
            <views:HistoryView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>

    <Border Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="2"
            Classes="status-bar">
      <DockPanel LastChildFill="True" VerticalAlignment="Center">
        <ProgressBar DockPanel.Dock="Left"
                     IsIndeterminate="True"
                     IsVisible="{Binding StatusBar.IsBusy}"
                     Width="72"
                     Height="3"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"/>
        <TextBlock Classes="status-text"
                   Classes.alert="{Binding StatusBar.IsAlert}"
                   Text="{Binding StatusBar.StatusText}"
                   FontSize="12"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
