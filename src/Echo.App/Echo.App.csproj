<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.8.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- macOS platform assembly only when targeting/building on macOS (stubs otherwise). -->
    <IncludeMacOs Condition="'$(IncludeMacOs)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">true</IncludeMacOs>
    <IncludeMacOs Condition="'$(IncludeMacOs)' == '' and '$(RuntimeIdentifier)' != '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx'))">true</IncludeMacOs>
    <IncludeMacOs Condition="'$(IncludeMacOs)' == ''">false</IncludeMacOs>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IncludeMacOs)' == 'true'">
    <DefineConstants>$(DefineConstants);INCLUDE_MACOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Echo.Abstractions\Echo.Abstractions.csproj" />
    <ProjectReference Include="..\Echo.Core\Echo.Core.csproj" />
    <ProjectReference Include="..\Echo.Engines\Echo.Engines.csproj" />
    <ProjectReference Include="..\Echo.Platform.Windows\Echo.Platform.Windows.csproj" />
    <ProjectReference Include="..\Echo.Platform.Linux\Echo.Platform.Linux.csproj" />
    <ProjectReference Include="..\Echo.Platform.MacOS\Echo.Platform.MacOS.csproj" Condition="'$(IncludeMacOs)' == 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <DirectMlNativeDir>$(MSBuildThisFileDirectory)..\..\native\win-x64\directml\</DirectMlNativeDir>
    <DirectMlNativeReady>false</DirectMlNativeReady>
    <DirectMlNativeReady Condition="Exists('$(DirectMlNativeDir)sherpa-onnx-c-api.dll')">true</DirectMlNativeReady>
    <!-- Default: do not bake DirectML into Release publishes (download on GPU select). Debug still copies for local GPU testing. -->
    <ShipDirectMl Condition="'$(ShipDirectMl)' == '' and '$(Configuration)' == 'Debug'">true</ShipDirectMl>
    <ShipDirectMl Condition="'$(ShipDirectMl)' == ''">false</ShipDirectMl>
  </PropertyGroup>

  <Target Name="CopyDirectMlNative" AfterTargets="Build"
          Condition="'$(ShipDirectMl)' == 'true' and '$(DirectMlNativeReady)' == 'true' and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')))">
    <PropertyGroup>
      <_DirectMlOutDir Condition="'$(_DirectMlOutDir)' == ''">$(OutputPath)</_DirectMlOutDir>
    </PropertyGroup>
    <ItemGroup>
      <DirectMlNativeDlls Include="$(DirectMlNativeDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(_DirectMlOutDir)directml\" />
    <Copy SourceFiles="@(DirectMlNativeDlls)" DestinationFolder="$(_DirectMlOutDir)directml\" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Echo: copied DirectML runtime to $(_DirectMlOutDir)directml\" />
  </Target>

  <Target Name="PrepareWinPublish" BeforeTargets="_ComputeFilesToBundle"
          DependsOnTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(RelativePath)').Contains('runtimes/linux'))
                  Or $([System.String]::Copy('%(RelativePath)').Contains('runtimes/macos'))
                  Or $([System.String]::Copy('%(RelativePath)').EndsWith('.pdb'))
                  Or $([System.String]::Copy('%(RelativePath)').EndsWith('.lib'))
                  Or $([System.String]::Copy('%(RelativePath)').EndsWith('.metal'))" />
      <DirectMlNativeForPublish Include="$(DirectMlNativeDir)*.dll" Condition="'$(ShipDirectMl)' == 'true' and '$(DirectMlNativeReady)' == 'true'" />
      <ResolvedFileToPublish Include="@(DirectMlNativeForPublish)" Condition="'$(ShipDirectMl)' == 'true' and '$(DirectMlNativeReady)' == 'true'">
        <RelativePath>directml\%(DirectMlNativeForPublish.Filename)%(DirectMlNativeForPublish.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="PrepareLinuxPublish" BeforeTargets="_ComputeFilesToBundle"
          DependsOnTargets="ComputeResolvedFilesToPublishList"
          Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux')) and '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(RelativePath)').Contains('runtimes/win'))
                  Or $([System.String]::Copy('%(RelativePath)').Contains('runtimes/macos'))
                  Or $([System.String]::Copy('%(RelativePath)').Contains('directml'))
                  Or $([System.String]::Copy('%(RelativePath)').EndsWith('.pdb'))
                  Or $([System.String]::Copy('%(RelativePath)').EndsWith('.metal'))" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareOsxPublish" BeforeTargets="_ComputeFilesToBundle"
          DependsOnTargets="ComputeResolvedFilesToPublishList"
          Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx')) and '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(RelativePath)').Contains('runtimes/linux'))
                  Or $([System.String]::Copy('%(RelativePath)').Contains('runtimes/win'))
                  Or $([System.String]::Copy('%(RelativePath)').Contains('directml'))
                  Or $([System.String]::Copy('%(RelativePath)').EndsWith('.pdb'))" />
    </ItemGroup>
  </Target>
</Project>
