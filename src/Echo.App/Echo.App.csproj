<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Echo.Abstractions\Echo.Abstractions.csproj" />
    <ProjectReference Include="..\Echo.Core\Echo.Core.csproj" />
    <ProjectReference Include="..\Echo.Engines\Echo.Engines.csproj" />
    <ProjectReference Include="..\Echo.Platform.Windows\Echo.Platform.Windows.csproj" />
    <ProjectReference Include="..\Echo.Platform.MacOS\Echo.Platform.MacOS.csproj" />
    <ProjectReference Include="..\Echo.Platform.Linux\Echo.Platform.Linux.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <DirectMlNativeDir>$(MSBuildThisFileDirectory)..\..\native\win-x64\directml\</DirectMlNativeDir>
    <DirectMlNativeReady>false</DirectMlNativeReady>
    <DirectMlNativeReady Condition="Exists('$(DirectMlNativeDir)sherpa-onnx-c-api.dll')">true</DirectMlNativeReady>
  </PropertyGroup>

  <Target Name="CopyDirectMlNative" AfterTargets="Build"
          Condition="'$(DirectMlNativeReady)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <DirectMlNativeDlls Include="$(DirectMlNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DirectMlNativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(OutputPath)directml.enabled"
                      Lines="DirectML runtime deployed from native/win-x64/directml"
                      Overwrite="true" />
    <Message Importance="high" Text="Echo: copied DirectML native runtime to $(OutputPath)" />
  </Target>

  <Target Name="CopyDirectMlNativePublish" AfterTargets="Publish"
          Condition="'$(DirectMlNativeReady)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <DirectMlNativeDlls Include="$(DirectMlNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DirectMlNativeDlls)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(PublishDir)directml.enabled"
                      Lines="DirectML runtime deployed from native/win-x64/directml"
                      Overwrite="true" />
  </Target>
</Project>
